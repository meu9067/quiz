# Copy this file to .env and uncomment to use.

# Overrides "today" for local testing, e.g. to try out a date's page or the
# home page's "Go to today's page" link without waiting for the real date.
# Format: YYYY-MM-DD. Leave unset (or delete the line) to use the real date.
# TEST_DATE_OVERRIDE=2026-11-09
