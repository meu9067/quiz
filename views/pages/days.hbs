<section>
  <h1>Tous les jours</h1>
  <p>Chaque page de jour qui existe pour l'instant — les nouvelles apparaissent ici automatiquement, rien à ajouter à la main.</p>
  {{#if days.length}}
    <ul id="days-list">
      {{#each days}}
        <li><a href="/day/{{this}}?date=true">{{this}}</a></li>
      {{/each}}
    </ul>
  {{else}}
    <p>Aucune page de jour pour l'instant.</p>
  {{/if}}
</section>
