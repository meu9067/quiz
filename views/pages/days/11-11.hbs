<section>
  <h1>Jour {{date}}</h1>
  <p id="day-greeting"></p>
</section>

<section
  data-js="drop-game"
  data-drop-max-mistakes="3"
  data-drop-storage-key="drop-11-11"
>
  <h2 class="green">Remplis le sac de papi avec les choses qu’il avait toujours sur lui.
  </h2>
  <p class="red">Attention ! Si tu te trompes plus de deux fois, tu perds le mot du jour...</p>

  <div class="drop-field" data-drop-field>
    <div class="drop-box" data-drop-target><img src="/images/sac/sac0.png"></div>

    <div id="drop-obj-1" class="drop-object" data-drop-object data-drop-valid="true"><img src="/images/sac/sac1.png"></div>
    <div id="drop-obj-2" class="drop-object" data-drop-object data-drop-valid="false"><img src="/images/sac/sac2.png"></div>
    <div id="drop-obj-3" class="drop-object" data-drop-object data-drop-valid="true"><img src="/images/sac/sac3.png"></div>
    <div id="drop-obj-4" class="drop-object" data-drop-object data-drop-valid="false"><img src="/images/sac/sac4.png"></div>
    <div id="drop-obj-5" class="drop-object" data-drop-object data-drop-valid="true"><img src="/images/sac/sac5.png"></div>
    <div id="drop-obj-6" class="drop-object" data-drop-object data-drop-valid="true"><img src="/images/sac/sac6.png"></div>
    <div id="drop-obj-7" class="drop-object" data-drop-object data-drop-valid="false"><img src="/images/sac/sac7.png"></div>
    <div id="drop-obj-8" class="drop-object" data-drop-object data-drop-valid="true"><img src="/images/sac/sac8.png"></div>

  </div>

  <p data-drop-status></p>
</section>

{{> win-form-wrapper id="drop" heading="Tu as tout trié ! 🎉" form=formsByName.dayDrop1111}}

