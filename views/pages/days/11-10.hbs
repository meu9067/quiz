<section>
  <h1>Day 11-10</h1>
  <p>This page was generated for <strong>{{date}}</strong>.</p>
  <p id="day-greeting"></p>
</section>

<section
  data-js="hangman-game"
  data-hangman-word="GIRAFFE"
  data-hangman-max-mistakes="5"
  data-hangman-storage-key="hangman-11-10"
>
  <h2>Hangman</h2>
  <p>Guess the word one letter at a time. You only get 4 wrong guesses.</p>
  <img data-hangman-image class="hangman-image" alt="Hangman stage 0" />
  <p class="hangman-word" data-hangman-word-display></p>
  <div class="hangman-keyboard" data-hangman-keyboard></div>
  <p data-hangman-status></p>
</section>

<section id="hangman-form-wrapper" hidden>
  <h2>You guessed it! 🎉</h2>
  {{> form formsByName.dayHangman1110}}
</section>

<p><a href="/">Back home</a></p>
