<section>
  <h1>Jour {{date}}</h1>
  <p id="day-greeting"></p>
</section>

<section
  data-js="hangman-game"
  data-hangman-word="RICORE"
  data-hangman-max-mistakes="4"
  data-hangman-storage-key="hangman-11-10"
>
  <p class="hangman-speach">Attention !
    Chaque fois que tu
    te trompes , je perds
    un objet qui me tient
    à coeur !</p>
  <div class="hangman">
    <div class="hangman__image-wrapper">
      <span class="hangman-jewel" data-hangman-jewel aria-hidden="true"></span>
      <img data-hangman-image class="hangman-image" alt="Hangman stage 0"/>
    </div>
    <div class="hangman__game-wrapper">
      <p class="hangman-word" data-hangman-word-display></p>
      <div class="hangman-keyboard" data-hangman-keyboard></div>
      <p data-hangman-status></p>
      <p class="green">INDICE : Boisson de papi au petit déjeuner</p>
    </div>
  </div>
</section>

{{> win-form-wrapper id="hangman" heading="Tu as deviné ! 🎉" form=formsByName.dayHangman1110}}


