<section>
  <h1>Jour {{date}}</h1>
  <p id="day-greeting"></p>
</section>

<section
  data-js="flappy-game"
  data-flappy-max-losses="10"
  data-flappy-goal-distance="2000"
  data-flappy-storage-key="flappy-11-12"
>
  <h2>Vole jusqu'au drapeau</h2>
    <p data-flappy-status></p>


  <div class="flappy-field" data-flappy-field>
      <button type="button" class="btn" data-flappy-start>Commencer</button>
      <div class="flappy-bird" data-flappy-bird style="left: 80px;"><img src="/images/flappy/ham.png" style="width: 80px; height: 80px;"></div>
    <div class="flappy-goal" data-flappy-goal></div>
  </div>

</section>

{{> win-form-wrapper id="flappy" heading="Tu as atteint le drapeau ! 🎉" form=formsByName.dayFlappy1112}}

