{
  "name": "website",
  "version": "1.0.0",
  "description": "Express + Handlebars site with dynamic page-folder routing, partials, SCSS and vanilla JS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "scss": "sass --watch scss/main.scss:public/css/main.css",
    "scss:build": "sass scss/main.scss:public/css/main.css --style=compressed",
    "build:static": "node scripts/build-static.js",
    "build": "npm run scss:build && npm run build:static",
    "watch": "concurrently -k -n server,scss \"npm run dev\" \"npm run scss\"",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-handlebars": "^7.1.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.0",
    "nodemon": "^3.1.4",
    "sass": "^1.77.8"
  }
}
